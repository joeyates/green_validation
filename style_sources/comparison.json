{
  "sources": [
    {
      "id": "mix_format",
      "name": "mix format",
      "repo_url": "https://github.com/elixir-lang/elixir"
    },
    {
      "id": "lexmag",
      "name": "Lexmag's Elixir Style Guide",
      "repo_url": "https://github.com/lexmag/elixir-style-guide"
    },
    {
      "id": "credo",
      "name": "Credo's Elixir Style Guide",
      "repo_url": "https://github.com/rrrene/elixir-style-guide"
    },
    {
      "id": "christopher_adams",
      "name": "The Elixir Style Guide",
      "repo_url": "https://github.com/christopheradams/elixir_style_guide"
    }
  ],
  "rules_with_no_source": [],
  "rules": [
    {
      "id": "spaces_around_binary_operators",
      "title": "Spaces around binary operators",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code/formatter.ex — binary operator spacing",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#spaces-in-code",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#spaces-operators",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#spaces",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "1+1",
        "good": "1 + 1"
      },
      "proposed_by": [
        "mix_format",
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "no_spaces_around_range_operator",
      "title": "No spaces around the range operator",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code/formatter.ex @no_space_binary_operators",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#no-spaces-in-code",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#no-spaces",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "1 .. 2",
        "good": "1..2"
      },
      "proposed_by": [
        "mix_format",
        "lexmag",
        "christopher_adams"
      ]
    },
    {
      "id": "two_space_indentation",
      "title": "Two-space indentation",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#spaces-indentation",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#spaces-indentation",
          "proposed": true
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "formatting",
      "example": {
        "bad": "if x do\n    :ok\nend",
        "good": "if x do\n  :ok\nend"
      },
      "proposed_by": [
        "lexmag",
        "credo"
      ]
    },
    {
      "id": "max_line_length",
      "title": "Maximum line length",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "proposed": false
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#character-per-line-limit",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#line-length",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "{:ok, [one, two, three, four, five, six, seven, eight, nine, ten, eleven]}",
        "good": "{:ok,\n [one, two, three, four, five,\n  six, seven, eight, nine, ten]}"
      },
      "proposed_by": [
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "no_trailing_whitespace",
      "title": "No trailing whitespace",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#no-trailing-whitespaces",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#no-trailing-whitespace",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#trailing-whitespace",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "x = 1   ",
        "good": "x = 1"
      },
      "proposed_by": [
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "spaces_after_commas",
      "title": "Space after commas",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code/formatter.ex — collection element spacing",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#spaces-in-code",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#spaces-operators",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#spaces",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "[1,2]",
        "good": "[1, 2]"
      },
      "proposed_by": [
        "mix_format",
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "no_spaces_inside_brackets",
      "title": "No spaces inside brackets",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code/formatter.ex — no padding inside brackets/braces/parens",
          "proposed": true
        },
        "lexmag": {
          "proposed": false
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#spaces-braces",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#spaces",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "[ 1, 2 ]",
        "good": "[1, 2]"
      },
      "proposed_by": [
        "mix_format",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "no_semicolons",
      "title": "No semicolons between statements",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code.ex Code.format_string!/2 docs — statements split onto separate lines",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#no-semicolon",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#semicolon-between-statements",
          "proposed": true
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "formatting",
      "example": {
        "bad": "a = 1; b = 2",
        "good": "a = 1\nb = 2"
      },
      "proposed_by": [
        "mix_format",
        "lexmag",
        "credo"
      ]
    },
    {
      "id": "no_trailing_comma",
      "title": "No trailing comma in collections",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code/formatter.ex — trailing comma removed from single-line collections",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#trailing-comma",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "formatting",
      "example": {
        "bad": "[1, 2,]",
        "good": "[1, 2]"
      },
      "proposed_by": [
        "mix_format",
        "lexmag"
      ]
    },
    {
      "id": "collapse_consecutive_blank_lines",
      "title": "Collapse consecutive blank lines",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code.ex Code.format_string!/2 docs — Keeping user's formatting (newlines)",
          "proposed": true
        },
        "lexmag": {
          "proposed": false
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "formatting",
      "example": {
        "bad": "a = 1\n\n\nb = 2",
        "good": "a = 1\n\nb = 2"
      },
      "proposed_by": [
        "mix_format"
      ]
    },
    {
      "id": "comment_leading_space",
      "title": "Space after the comment marker",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code.ex Code.format_string!/2 docs — Code comments",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#leading-space-comment",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#comment-leading-spaces",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "#comment",
        "good": "# comment"
      },
      "proposed_by": [
        "mix_format",
        "lexmag",
        "christopher_adams"
      ]
    },
    {
      "id": "digit_grouping_underscores",
      "title": "Group digits in large numbers",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code.ex Code.format_string!/2 docs — Keeping user's formatting (numbers)",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#underscores-in-numerics",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#underscores-in-numerics",
          "proposed": true
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "formatting",
      "example": {
        "bad": "1000000",
        "good": "1_000_000"
      },
      "proposed_by": [
        "mix_format",
        "lexmag",
        "credo"
      ]
    },
    {
      "id": "uppercase_hex_literals",
      "title": "Uppercase hexadecimal literals",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code.ex Code.format_string!/2 docs — Keeping user's formatting (numbers)",
          "proposed": true
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#hex-literals",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "formatting",
      "example": {
        "bad": "0xabcd",
        "good": "0xABCD"
      },
      "proposed_by": [
        "mix_format",
        "lexmag"
      ]
    },
    {
      "id": "unix_line_endings",
      "title": "Unix line endings",
      "sources": {
        "mix_format": {
          "status": "enforced",
          "reference": "code.ex Code.format_string!/2 docs — Newlines converted to \\n",
          "proposed": true
        },
        "lexmag": {
          "proposed": false
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#line-endings",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#line-endings",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "a = 1\\r\\nb = 2",
        "good": "a = 1\\nb = 2"
      },
      "proposed_by": [
        "mix_format",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "trailing_newline",
      "title": "Trailing newline at end of file",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#newline-eof",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#newline-eof",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#newline-eof",
          "proposed": true
        }
      },
      "category": "formatting",
      "example": {
        "bad": "(file ends without a newline)",
        "good": "(file ends with one \\n)"
      },
      "proposed_by": [
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "snake_case_atoms_and_variables",
      "title": "snake_case for atoms, variables and functions",
      "sources": {
        "mix_format": {
          "status": "not_enforced",
          "reference": "code.ex Code.format_string!/2 docs — does not hard code names",
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#snake-case-atoms-funs-vars-attrs",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#snake-case-attributes-functions-macros-vars",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#snake-case",
          "proposed": true
        }
      },
      "category": "naming",
      "example": {
        "bad": "fooBar = 1",
        "good": "foo_bar = 1"
      },
      "proposed_by": [
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "camel_case_modules",
      "title": "CamelCase for modules",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#camelcase-modules",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#camelcase-modules",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#camel-case",
          "proposed": true
        }
      },
      "category": "naming",
      "example": {
        "bad": "defmodule My_app do\nend",
        "good": "defmodule MyApp do\nend"
      },
      "proposed_by": [
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "predicate_function_question_mark",
      "title": "Question mark for predicate functions",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#predicate-funs-name",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#predicates",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#predicate-function-trailing-question-mark",
          "proposed": true
        }
      },
      "category": "naming",
      "example": {
        "bad": "def is_valid(x), do: true",
        "good": "def valid?(x), do: true"
      },
      "proposed_by": [
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "avoid_one_letter_variables",
      "title": "Avoid one-letter variable names",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#one-letter-var",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "naming",
      "example": {
        "bad": "u = get_user()",
        "good": "user = get_user()"
      },
      "proposed_by": [
        "lexmag"
      ]
    },
    {
      "id": "alphabetical_alias_order",
      "title": "Order alias/import/require alphabetically",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "proposed": false
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#module-attribute-ordering",
          "proposed": true
        }
      },
      "category": "modules",
      "example": {
        "bad": "alias App.Zebra\nalias App.Apple",
        "good": "alias App.Apple\nalias App.Zebra"
      },
      "proposed_by": [
        "christopher_adams"
      ]
    },
    {
      "id": "module_pseudo_variable",
      "title": "Use the __MODULE__ pseudo-variable",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#current-module-reference",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#reference-current-module",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#module-pseudo-variable",
          "proposed": true
        }
      },
      "category": "modules",
      "example": {
        "bad": "%MyApp.User{name: n}",
        "good": "%__MODULE__{name: n}"
      },
      "proposed_by": [
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "module_attribute_layout",
      "title": "Consistent module attribute layout",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#module-layout",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#module-attribute-ordering",
          "proposed": true
        }
      },
      "category": "modules",
      "example": {
        "bad": "alias App.X\nuse GenServer\n@moduledoc \"...\"",
        "good": "@moduledoc \"...\"\nuse GenServer\nalias App.X"
      },
      "proposed_by": [
        "lexmag",
        "christopher_adams"
      ]
    },
    {
      "id": "pipeline_for_chains",
      "title": "Use pipelines for chained calls",
      "sources": {
        "mix_format": {
          "status": "not_enforced",
          "reference": "code.ex Code.format_string!/2 docs — never changes semantics",
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#pipeline-operator",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#pipe-operator",
          "proposed": true
        }
      },
      "category": "expressions",
      "example": {
        "bad": "f(g(h(x)))",
        "good": "x |> h() |> g() |> f()"
      },
      "proposed_by": [
        "lexmag",
        "christopher_adams"
      ]
    },
    {
      "id": "no_pipeline_for_single_call",
      "title": "Avoid needless pipelines",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#needless-pipeline",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#avoid-single-pipelines",
          "proposed": true
        }
      },
      "category": "expressions",
      "example": {
        "bad": "x |> f()",
        "good": "f(x)"
      },
      "proposed_by": [
        "lexmag",
        "christopher_adams"
      ]
    },
    {
      "id": "no_anonymous_functions_in_pipelines",
      "title": "No anonymous functions in pipelines",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#anonymous-pipeline",
          "proposed": true
        },
        "credo": {
          "proposed": false
        },
        "christopher_adams": {
          "proposed": false
        }
      },
      "category": "expressions",
      "example": {
        "bad": "x |> (fn v -> v + 1 end).()",
        "good": "x |> increment()"
      },
      "proposed_by": [
        "lexmag"
      ]
    },
    {
      "id": "no_else_in_unless",
      "title": "No else clause with unless",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#no-else-with-unless",
          "proposed": true
        },
        "credo": {
          "reference": "https://github.com/rrrene/elixir-style-guide#no-unless-with-else",
          "proposed": true
        },
        "christopher_adams": {
          "reference": "https://github.com/christopheradams/elixir_style_guide#unless-with-else",
          "proposed": true
        }
      },
      "category": "expressions",
      "example": {
        "bad": "unless x do\n  a\nelse\n  b\nend",
        "good": "if x do\n  b\nelse\n  a\nend"
      },
      "proposed_by": [
        "lexmag",
        "credo",
        "christopher_adams"
      ]
    },
    {
      "id": "true_as_last_cond_clause",
      "title": "Use true as the last cond clause",
      "sources": {
        "mix_format": {
          "proposed": false
        },
        "lexmag": {
          "reference": "https://github.com/lexmag/elixir-style-guide#true-in-cond",
          "proposed": true
        },
        "credo": {
